# Optional live service settings. Never commit actual credentials.
ERASE_WEB_HOME=~/.erase-me-web
# Set only behind a TLS reverse proxy for public hosting.
# ERASE_WEB_ORIGIN=https://privacy.example.com
ERASE_SMTP_HOST=
ERASE_SMTP_PORT=587
ERASE_SMTP_FROM=
ERASE_SMTP_USER=
ERASE_SMTP_PASSWORD=
ERASE_SMTP_SSL=false

# Absolute executable implementing docs/ADAPTER_PROTOCOL.md.
ERASE_ME_ADAPTER=
# Bundled recipe-based browser adapter configuration:
ERASE_BROWSE_BIN=
ERASE_BROWSER_RECIPES=
# Free local CAPTCHA recognition. Optional executable overrides; PATH used otherwise.
# No solver account, API key, or cloud fallback.
ERASE_TESSERACT_BIN=
ERASE_WHISPER_BIN=
ERASE_FFMPEG_BIN=
# A local whisper.cpp-compatible model, downloaded separately.
ERASE_WHISPER_MODEL=

# Dedicated service inbox for removal confirmations; requires plus-addressing.
ERASE_REMOVAL_INBOX=
ERASE_IMAP_HOST=
ERASE_IMAP_PORT=993
ERASE_IMAP_USER=
ERASE_IMAP_PASSWORD=
# Trusted Authentication-Results authserv-id from your receiving provider.
ERASE_IMAP_AUTHSERV_ID=
