{
  "manifest_version": 3,
  "name": "Erase Me Companion",
  "version": "0.12.0",
  "description": "Fill approved privacy forms in your browser. No personal inbox access or scheduled work.",
  "permissions": ["scripting", "storage"],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": [
    "https://privacy.peopledatalabs.com/*",
    "https://www.usphonebook.com/*",
    "https://www.searchpeoplefree.com/*",
    "https://www.fastpeoplesearch.com/*",
    "https://www.apollo.io/*",
    "https://www.spokeo.com/*",
    "https://www.advancedbackgroundchecks.com/*",
    "https://www.smartbackgroundchecks.com/*",
    "https://www.familytreenow.com/*",
    "https://www.nosorgulama.com.tr/*",
    "https://www.numaraara.com/*",
    "https://www.numarasor.com/*",
    "https://www.telefonsorgulama.com/*",
    "https://www.peopletraceuk.com/*",
    "https://www.mylife.com/*",
    "https://mylife.jotform.com/*",
    "https://www.whitepages.com/*",
    "https://cmadnm.cawebhosting.ca/*",
    "https://thatsthem.com/*",
    "https://www.peoplefinders.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Erase Me Companion"},
  "content_scripts": [{"matches": ["https://erase-me-preview.vercel.app/*"], "js": ["bridge.js"], "run_at": "document_start"}]
}
